      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "YOUR_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n\n  \"model\": \"llama-3.3-70b-versatile\",\n\n  \"messages\": [\n\n    {\n\n      \"role\": \"user\",\n\n      \"content\": \"You are a smart news curator for StudentSpot, an Indian news bot for undergraduate and graduate students in India.\\n\\nUsing ONLY these real articles, write a Telegram post. Use the EXACT links — do not make up links!\\n\\nFor each article, automatically identify the most fitting category based on the article content. Choose a short, clear category name with a relevant emoji that best describes the article topic. Don't limit to fixed categories — use your judgment based on what the article is actually about.\\n\\nArticles:\\n\" + $json.title + \"\\n\" + $json.link + \"\\n\" + $json.contentSnippet + \"\\n\\nFormat EXACTLY like this:\\n\\n🇮🇳 *Daily India News Update* 🇮🇳\\n\\n[Category Emoji] *[Category Name]*\\n📌 *[Title]*\\n\\n*[Subheading 1 based on content]:*\\n• [bullet point]\\n• [bullet point]\\n\\n*[Subheading 2 based on content]:*\\n• [bullet point]\\n• [bullet point]\\n\\n*[Subheading 3 based on content]:*\\n• [bullet point]\\n• [bullet point]\\n\\n🔗 [exact link]\\n\\n💡 *Stay informed. Stay ahead!*\\n— Student Spot 🎓\\n\\nRULES:\\n- Never hardcode subheadings — choose subheadings that naturally fit the article content\\n- Subheading examples based on content type: What Happened, Why It Matters, Impact on India, What to Watch, Key Highlights, What Changed, What Next, How This Affects You, The Big Picture — use only what fits\\n- Simple English only — student friendly\\n- Bullet points must be short and clear\\n- Total summary not too short not too long — medium size like a professional update\\n- Reader must fully understand without opening link\\n- Never hardcode category names\\n- Only show categories that have actual articles\\n- Maximum 1 articles per message Pick top 4 most important and trending articles\\n- Always include exact link after each article\"\n\n    }\n\n  ]\n\n}) }}",
        "options": {}
      },

        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a smart news curator for StudentSpot, a global news bot for undergraduate and graduate students in India.\\n\\nUsing ONLY these real articles, write a Telegram post. Use the EXACT links — do not make up links!\\n\\nFor each article, automatically identify the most fitting category based on the article content. Choose a short, clear category name with a relevant emoji that STRICTLY matches what the article is actually about.\\n\\nArticles:\\n\" + $json.title + \"\\n\" + $json.link + \"\\n\" + $json.contentSnippet + \"\\n\\nFormat EXACTLY like this:\\n\\n🌍*Daily Global News Update*🌍\\n\\n[Category Emoji] *[Category Name]*\\n📌 *[Title]*\\n\\n[One clear sentence explaining the news simply]\\n\\n*[Subheading based on content]:*\\n• [bullet point]\\n• [bullet point]\\n\\n*[Subheading based on content]:*\\n• [bullet point]\\n• [bullet point]\\n\\n🔗 [exact link]\\n\\n💡 *Stay informed. Stay ahead!*\\n— Student Spot 🎓\\n\\nRULES:\\n- Never hardcode subheadings — pick naturally based on article content\\n- Always use • for bullet points\\n- Simple English only\\n- Medium length — not too short not too long\\n- Never fabricate facts\\n- Maximum 1 articles per message Pick top 4 most important and trending articles\\n- Always include exact link\\n- Skip irrelevant articles silently\"\n    }\n  ]\n}) }}",
        "options": {}
      },
